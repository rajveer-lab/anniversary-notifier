{
  "name": "anniversary-notifier",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/smrati/anniversary-notifier#readme",
  "bugs": {
    "url": "https://github.com/smrati/anniversary-notifier/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smrati/anniversary-notifier.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.staffping.app",
    "productName": "StaffPing",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "fusion-logo-square.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StaffPing"
    },
    "files": [
      "database.js",
      "main.js",
      "preload.js",
      "index.html",
      "fusion-logo.png",
      "fusion-logo-square.png"
    ],
    "asar": true
  }
}
